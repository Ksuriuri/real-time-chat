# Top-level env file consumed by start.sh + chat/cli.py.
# Copy to .env and fill in your keys. Per-module .env files still work for
# their own scripts and are independent from this file.

# Volcengine Ark (LLM)
ARK_API_KEY=your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260428

# Volcengine streaming ASR 2.0
VOLCENGINE_ASR_API_KEY=your-volcengine-asr-api-key
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# TTS provider: "volcengine" (seed-tts-2.0, default) or "fish" (Fish Audio).
TTS_PROVIDER=volcengine

# Volcengine seed-tts-2.0
VOLCENGINE_TTS_API_KEY=your-volcengine-tts-api-key
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
TTS_SPEAKER=zh_female_vv_uranus_bigtts
TTS_MODEL=seed-tts-2.0-standard

# Fish Audio TTS (only used when TTS_PROVIDER=fish). Get a key at
# https://fish.audio/app/api-keys/.
FISH_API_KEY=your-fish-audio-api-key
# Backend model: s1 (fast, broad availability) or s2-pro (latest).
FISH_MODEL=s1
# normal (best quality) | balanced (~300ms) | low (lowest latency).
FISH_LATENCY=balanced
# Zero-shot voice cloning from YOUR OWN sample: path to a 10-30s clear
# WAV/MP3/FLAC clip plus its exact transcript (transcript improves quality).
FISH_REFERENCE_AUDIO=
FISH_REFERENCE_TEXT=
# Alternative to a local sample: a hosted voice model id from fish.audio.
# Ignored when FISH_REFERENCE_AUDIO is set.
FISH_REFERENCE_ID=

# Local Silero VAD service (started by start.sh)
VAD_HOST=127.0.0.1
VAD_PORT=8010
VAD_WS_URL=ws://127.0.0.1:8010/v1/audio/vad/stream
VAD_API_KEY=
VAD_MIN_SILENCE_MS=500
VAD_MIN_SPEECH_MS=250
VAD_THRESHOLD=0.5
# Anti-jitter merge gap (ms). Hold speech_end this long; if a new
# speech_start arrives within the window, both events are dropped and the
# segment is treated as continuous. Set 0 to disable.
VAD_MIN_GAP_MS=300

# Acoustic Echo Cancellation (WebRTC AEC3 via pywebrtc-audio).
# Removes the assistant's own TTS output from the mic capture so it doesn't
# trigger false barge-ins on laptops without headphones.
ENABLE_AEC=1
# Noise suppression level applied alongside AEC: 0=6dB, 1=12dB, 2=18dB, 3=21dB.
AEC_NS_LEVEL=2
# Round-trip delay hint in ms (0 = let AEC3 estimate it itself, recommended).
AEC_STREAM_DELAY_MS=0

# Orchestrator behavior
SYSTEM_PROMPT="你是一个语音助手，回答简短自然，控制在两句话以内。回复可参考打工人、摆烂躺平emo、社交阴阳回复风格，偶尔自然借用这些短句或改写：收到，办不到；慢慢急，不要来；做我们这行的，最忌讳的就是做我们这行；我能扛起什么责任，我是个溜肩啊；虽然没挣钱，起码累着了；事情终于有了新的退展；我做事，你不必放心；腰栓栓的；一怒之下站起来，两眼一黑又坐下；这事儿交给我你就操心吧；这件事不急，但一定要快；明天有人想来我工位cosplay我吗；每个成功人士背后都有一个屁股；余额怎么是负鼠；多做多错，少做少错，不做不错不错不错；死到临头再说；窝囊到鼠；这几年里，我窝囊过，也窝囊过，窝囊过，也窝囊过；在装死，有问题吗；据我所知一无所知；先活着吧，其他的我再想办法；emo就是一个人momo心碎；关于明天的事，后天就知道了；没出息没关系，有气息已经很棒了；风雪压我两三年，加在一起是五年；1KB小脑正在思考；我时常在想我在想什么；已读不回，是在细品；你和她聊吧，有不会的字问我；你以为我没有脾气吗？我警告你：我没有；你退一万步讲，我根本听不见；话到嘴边又咽了下去；让我看看谁还在讲小话；需要我帮倒忙吗；我倒看看你还有什么说的；一方有难，八方添乱。只在语境合适时使用，不要连续罗列。"
LOG_LEVEL=INFO
